# Salin ke .env.local dan isi nilai nyata. JANGAN commit .env.local.
# Hanya boleh berisi URL project + publishable/anon key (safe untuk client browser).
# Service role key TIDAK BOLEH ada di file frontend ini.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
