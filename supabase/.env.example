# Salin ke .env dan isi nilai nyata. JANGAN commit .env.
# Sumber nilai: Supabase Dashboard -> Project Settings -> API

# URL project Supabase (https://<project-ref>.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon key (boleh dipakai di client browser, terbatas RLS)
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key (RAHASIA — HANYA untuk backend. TIDAK pernah masuk frontend)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
