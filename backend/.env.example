# Salin ke .env dan isi nilai nyata. JANGAN commit .env.
# Sumber nilai: Supabase Dashboard -> Project Settings -> API / Database.

# --- Database (Supabase Postgres) ---
# Pakai TRANSACTION POOLER port 6543 (bukan session pooler 5432): session
# pooler maks 15 koneksi sekaligus dari semua proses dan rentan EMAXCONNSESSION.
# Penting: koneksi asyncpg lewat transaction pooler WAJIB statement_cache_size=0
# (prepared statement tidak didukung mode transaction pgbouncer) — sudah diatur
# di app/core/database.py, jangan diubah tanpa alasan.
# Jika password mengandung karakter khusus, percent-encode (mis. @ -> %40).
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?ssl=require

# URL project Supabase (dipakai utk JWKS: {SUPABASE_URL}/auth/v1/.well-known/jwks.json)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service role key (RAHASIA — hanya dipakai di backend, tidak pernah di frontend)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Verifikasi JWT memakai public key dari JWKS (ES256). SUPABASE_JWT_SECRET
# (legacy HS256) hanya fallback token lama — kosongkan jika tidak dipakai.
SUPABASE_JWT_SECRET=

# Origin frontend yang diizinkan (CSRF/CORS), pisah dengan koma.
# CORS_ORIGINS=http://localhost:3000,https://webapp.example.com

# Mode development: true -> endpoint /health mengembalikan detail error DB,
# dan header X-GeoIP-Override-Lat/Lng dihormati (test deterministik).
# DIABAIKAN (false) di production.
DEV_MODE=true

# --- Face matching & liveness (threshold, bisa di-tuning) ---
# Threshold cosine similarity wajah (default 0.6). JANGAN turunkan demi testing.
MATCH_THRESHOLD=0.6
# Minimal mean frame diff (0-255) utk liveness — frame identik = foto statis.
LIVENESS_MIN_MEAN_DIFF=2.0

# --- Storage (bucket privat Supabase) ---
# Bucket foto sample wajah saat enrollment (harus dibuat via setup: storage bucket)
STORAGE_FACE_BUCKET=face-samples
# Bucket foto bukti percobaan absen (retensi otomatis 90 hari, NFR-5)
STORAGE_ATTENDANCE_BUCKET=attendance-evidence

# --- Rate limiting absensi per user ---
RATE_LIMIT_MAX_FAILURES=10
RATE_LIMIT_WINDOW_MINUTES=60
RATE_LIMIT_BLOCK_MINUTES=15

# --- Location verification (Sprint 3) — threshold default, bisa di-tuning ---
# GPS accuracy di bawah/atas nilai ini -> flag "suspicious" (bukan reject)
GPS_ACCURACY_MIN_M=2.0
GPS_ACCURACY_MAX_M=300.0
# Selisih GPS vs IP-geolocation melebihi ini (km) -> ip_mismatch_flag
GEOIP_MISMATCH_KM=200.0
# Teleport: kecepatan antar-absen melebihi ini (km/jam) -> reject
TELEPORT_MAX_SPEED_KMH=120.0
# Jendela perbandingan absen terakhir untuk teleport (jam)
TELEPORT_MAX_INTERVAL_HOURS=24.0
# Timeout lookup layanan geo-IP (detik)
GEOIP_LOOKUP_TIMEOUT_SECONDS=3.0

# --- Retention (NFR-5) ---
# Foto bukti absen dihapus otomatis setelah N hari
EVIDENCE_RETENTION_DAYS=90
# Interval task pembersihan retention (jam)
EVIDENCE_CLEANUP_INTERVAL_HOURS=24
